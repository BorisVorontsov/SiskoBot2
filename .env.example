# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=1234567890:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll

# ID чата для публикации (необязательно).
# Если оставить пустым, бот сам определит группу после добавления в неё.
# У групп ID отрицательный, например -1001234567890.
TELEGRAM_CHAT_ID=

# Случайный интервал между публикациями, часы (по умолчанию 2..6 по ТЗ)
MIN_INTERVAL_HOURS=2
MAX_INTERVAL_HOURS=6

# Путь к базе SQLite с состоянием
DB_PATH=data/state.db

# Источник цитат и базовый URL сайта
FEED_URL=https://башорг.рф/rss/
SITE_BASE_URL=https://башорг.рф

# Таймаут HTTP-запросов к сайту, секунды
HTTP_TIMEOUT_SECONDS=30

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
